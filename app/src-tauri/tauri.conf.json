{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoloPDF",
  "version": "0.6.0",
  "identifier": "app.solopdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoloPDF",
        "width": 1240,
        "height": 840,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "mainBinaryName": "SoloPDF",
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "MIT",
    "publisher": "alexlee",
    "homepage": "https://solopdf.doaipm.com",
    "shortDescription": "Free, ad-free, local-first PDF reader",
    "longDescription": "SoloPDF is a free, ad-free, local-first PDF reader. Highlights become Markdown notes that SoloMD can open, search, and version.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "description": "Plain text document",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "cbz",
          "cbr"
        ],
        "name": "Comic Archive",
        "description": "Comic book archive",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "mobi",
          "azw3"
        ],
        "name": "Kindle Book",
        "description": "Kindle e-book",
        "role": "Viewer",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "djvu",
          "djv"
        ],
        "name": "DjVu Document",
        "description": "DjVu scanned document",
        "role": "Viewer",
        "mimeType": "image/vnd.djvu"
      }
    ],
    "iOS": {
      "developmentTeam": "6NQM3XP5RF",
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "solopdf"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "solopdf"
          ]
        },
        {
          "scheme": [
            "content",
            "file"
          ]
        }
      ]
    }
  }
}
